<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.losalerces.sistematurnos.Controladores.ControladorReportePami"
      spacing="14"
      styleClass="vista-base">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Reporte PAMI" styleClass="titulo-vista"/>
            <Label text="Listado oficial de pacientes PAMI con turnos atendidos" styleClass="subtitulo-vista"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- NUEVO BOTÓN EXCEL -->
        <Button text="Generar Excel"
                onAction="#exportarExcel"
                styleClass="boton-principal"/>

        <Button text="Actualizar Reporte"
                onAction="#actualizarReporte"
                styleClass="boton-secundario"/>
    </HBox>

    <!-- TABLA DE REPORTE -->
    <TableView fx:id="tablaReportePami"
               VBox.vgrow="ALWAYS"
               styleClass="tabla-agenda">

        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="colHora" text="Hora" prefWidth="90"/>
            <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="200"/>
            <TableColumn fx:id="colDoctor" text="Doctor/a" prefWidth="180"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

</VBox>