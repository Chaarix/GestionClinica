<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.losalerces.sistematurnos.Controladores.DoctorController"
      spacing="14"
      styleClass="vista-base">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- ===================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================== -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="2">

            <Label text="Doctores"
                   styleClass="titulo-vista"/>

            <Label fx:id="lblTituloForm"
                   text="Registro y administración de médicos"
                   styleClass="subtitulo-vista"/>

        </VBox>

    </HBox>


    <!-- ===================================== -->
    <!-- FORMULARIO -->
    <!-- ===================================== -->

    <VBox spacing="12"
          styleClass="panel-formulario">

        <Label text="Datos del doctor"
               styleClass="titulo-seccion"/>


        <GridPane hgap="14"
                  vgap="10">

            <!-- NOMBRE -->

            <Label text="Nombre"
                   styleClass="label-campo"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtNombre"
                       promptText="Nombre"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>


            <!-- APELLIDO -->

            <Label text="Apellido"
                   styleClass="label-campo"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtApellido"
                       promptText="Apellido"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>


            <!-- DNI (Añadido para que coincida con el controlador) -->

            <Label text="DNI"
                   styleClass="label-campo"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtDni"
                       promptText="DNI"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>


            <!-- TELÉFONO -->

            <Label text="Teléfono"
                   styleClass="label-campo"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>

            <TextField fx:id="txtTelefono"
                       promptText="Teléfono"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>


            <!-- CORREO -->

            <Label text="Correo"
                   styleClass="label-campo"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

            <TextField fx:id="txtCorreo"
                       promptText="Correo electrónico"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>


            <!-- ESPECIALIDAD (ComboBox en lugar de TextField según tu controlador) -->

            <Label text="Especialidad"
                   styleClass="label-campo"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="2"/>

            <ComboBox fx:id="cmbEspecialidad"
                      promptText="Seleccionar especialidad"
                      maxWidth="Infinity"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="3"/>

        </GridPane>


        <!-- ===================================== -->
        <!-- OBRAS SOCIALES -->
        <!-- ===================================== -->

        <VBox spacing="8">

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <Label text="Obras sociales que acepta"
                       styleClass="label-campo"/>

                <Button text="+ Administrar obras sociales"
                        onAction="#administrarObrasSociales"
                        styleClass="boton-secundario"/>

            </HBox>


            <FlowPane fx:id="contenedorObrasSociales"
                      hgap="18"
                      vgap="8"
                      prefWrapLength="700"/>

        </VBox>


        <!-- ===================================== -->
        <!-- BOTONES -->
        <!-- ===================================== -->

        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <Button text="Limpiar"
                    onAction="#handleLimpiarFormulario"
                    styleClass="boton-secundario"/>

            <Button fx:id="btnEliminar"
                    text="Eliminar"
                    onAction="#handleEliminar"
                    styleClass="boton-secundario"/>

            <Button fx:id="btnGuardar"
                    text="Guardar doctor"
                    onAction="#handleGuardar"
                    styleClass="boton-principal"/>

        </HBox>

    </VBox>


    <!-- ===================================== -->
    <!-- BUSCADOR -->
    <!-- ===================================== -->

    <HBox spacing="10"
          alignment="CENTER_LEFT">

        <TextField fx:id="txtBuscar"
                   promptText="Buscar por apellido o DNI..."
                   HBox.hgrow="ALWAYS"
                   styleClass="buscador"/>

    </HBox>


    <!-- ===================================== -->
    <!-- TABLA -->
    <!-- ===================================== -->

    <TableView fx:id="tblDoctores"
               VBox.vgrow="ALWAYS"
               styleClass="tabla-agenda">

        <columns>

            <TableColumn fx:id="colDni"
                         text="DNI"
                         prefWidth="100"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="120"/>

            <TableColumn fx:id="colApellido"
                         text="Apellido"
                         prefWidth="120"/>

            <TableColumn fx:id="colEspecialidad"
                         text="Especialidad"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>