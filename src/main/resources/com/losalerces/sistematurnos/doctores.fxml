<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.losalerces.sistematurnos.Controladores.controladorDoctores"
      spacing="12"
      minWidth="0"
      minHeight="0"
      maxWidth="Infinity"
      maxHeight="Infinity"
      fillWidth="true"
      styleClass="vista-base">

    <padding>
        <Insets top="8"
                right="8"
                bottom="8"
                left="8"/>
    </padding>


    <!-- ================================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================================= -->

    <HBox alignment="CENTER_LEFT"
          spacing="10"
          minHeight="45"
          maxWidth="Infinity">

        <VBox spacing="2"
              minWidth="0"
              HBox.hgrow="ALWAYS">

            <Label text="Doctores"
                   styleClass="titulo-vista"/>

            <Label text="Registro y administración de médicos"
                   styleClass="subtitulo-vista"/>

        </VBox>

    </HBox>


    <!-- ================================================= -->
    <!-- FORMULARIO -->
    <!-- ================================================= -->

    <VBox spacing="12"
          maxWidth="Infinity"
          styleClass="panel-formulario">

        <Label text="Datos del doctor"
               styleClass="titulo-seccion"/>


        <GridPane hgap="14"
                  vgap="10"
                  maxWidth="Infinity">

            <columnConstraints>

                <ColumnConstraints percentWidth="33.33"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="33.33"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="33.34"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <!-- NOMBRE -->

            <Label text="Nombre"
                   styleClass="label-campo"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtNombre"
                       promptText="Nombre"
                       maxWidth="Infinity"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>


            <!-- APELLIDO -->

            <Label text="Apellido"
                   styleClass="label-campo"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtApellido"
                       promptText="Apellido"
                       maxWidth="Infinity"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>


            <!-- ESPECIALIDAD -->

            <Label text="Especialidad"
                   styleClass="label-campo"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtEspecialidad"
                       promptText="Ej. Pediatría"
                       maxWidth="Infinity"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>


            <!-- DURACIÓN -->

            <Label text="Duración de consulta"
                   styleClass="label-campo"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>

            <ComboBox fx:id="cmbDuracion"
                      promptText="Seleccionar duración"
                      maxWidth="Infinity"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="3"/>

        </GridPane>


        <!-- ================================================= -->
        <!-- OBRAS SOCIALES -->
        <!-- ================================================= -->

        <VBox spacing="8"
              maxWidth="Infinity">

            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  maxWidth="Infinity">

                <Label text="Obras sociales que acepta"
                       styleClass="label-campo"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button text="+ Administrar obras sociales"
                        onAction="#administrarObrasSociales"
                        styleClass="boton-secundario"/>

            </HBox>


            <FlowPane fx:id="contenedorObrasSociales"
                      hgap="18"
                      vgap="8"
                      prefWrapLength="700"
                      maxWidth="Infinity"/>

        </VBox>


        <!-- ================================================= -->
        <!-- BOTONES -->
        <!-- ================================================= -->

        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              maxWidth="Infinity">

            <Button text="Limpiar"
                    onAction="#limpiarFormulario"
                    styleClass="boton-secundario"/>

            <Button fx:id="btnModificar"
                    text="Modificar"
                    onAction="#modificarDoctor"
                    styleClass="boton-secundario"/>

            <Button text="Guardar doctor"
                    onAction="#guardarDoctor"
                    styleClass="boton-principal"/>

        </HBox>

    </VBox>


    <!-- ================================================= -->
    <!-- BUSCADOR -->
    <!-- ================================================= -->

    <HBox spacing="10"
          alignment="CENTER_LEFT"
          maxWidth="Infinity">

        <TextField fx:id="txtBuscar"
                   promptText="Buscar por nombre, apellido o especialidad..."
                   maxWidth="Infinity"
                   HBox.hgrow="ALWAYS"
                   styleClass="buscador"/>

        <Button text="Buscar"
                onAction="#buscarDoctor"
                styleClass="boton-secundario"/>

    </HBox>


    <!-- ================================================= -->
    <!-- TABLA -->
    <!-- ================================================= -->

    <TableView fx:id="tablaDoctores"
               minHeight="0"
               maxWidth="Infinity"
               maxHeight="Infinity"
               VBox.vgrow="ALWAYS"
               styleClass="tabla-agenda">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         minWidth="45"
                         prefWidth="55"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         minWidth="90"
                         prefWidth="120"/>

            <TableColumn fx:id="colApellido"
                         text="Apellido"
                         minWidth="90"
                         prefWidth="120"/>

            <TableColumn fx:id="colEspecialidad"
                         text="Especialidad"
                         minWidth="110"
                         prefWidth="150"/>

            <TableColumn fx:id="colDuracion"
                         text="Duración"
                         minWidth="85"
                         prefWidth="100"/>

            <TableColumn fx:id="colObrasSociales"
                         text="Obras sociales"
                         minWidth="140"
                         prefWidth="220"/>

            <TableColumn fx:id="colAcciones"
                         text="Acciones"
                         minWidth="90"
                         prefWidth="110"/>

        </columns>

    </TableView>

</VBox>