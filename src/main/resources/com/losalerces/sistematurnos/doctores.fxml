<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.losalerces.sistematurnos.Controladores.controladorDoctores"
      spacing="12"
      styleClass="vista-base">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="2">

            <Label text="Doctores"
                   styleClass="titulo-vista"/>

            <Label text="Gestión de médicos y especialidades"
                   styleClass="subtitulo-vista"/>

        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnAgregarDoctor"
                text="+ Agregar doctor"
                onAction="#agregarDoctor"
                styleClass="boton-principal"/>

    </HBox>

    <TextField fx:id="txtBuscarDoctor"
               promptText="Buscar doctor..."
               onAction="#buscarDoctor"
               styleClass="buscador"/>

    <TableView fx:id="tablaDoctores"
               VBox.vgrow="ALWAYS"
               styleClass="tabla">

        <columns>

            <TableColumn text="Nombre"
                         prefWidth="170"/>

            <TableColumn text="Apellido"
                         prefWidth="170"/>

            <TableColumn text="Especialidad"
                         prefWidth="190"/>

            <TableColumn text="Obras sociales"
                         prefWidth="210"/>

            <TableColumn text="Acciones"
                         prefWidth="110"/>

        </columns>

    </TableView>

</VBox>