<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.losalerces.sistematurnos.controladores.controladorMenuprincipal"
            prefWidth="950"
            prefHeight="620"
            stylesheets="@style.css"
            styleClass="root-principal">

    <top>
        <HBox alignment="TOP_RIGHT"
              spacing="0"
              styleClass="header">

            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <StackPane HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="4">
                <ImageView fx:id="iv" fitHeight="59.0" fitWidth="101.0" layoutX="306.0" layoutY="240.0" pickOnBounds="true" preserveRatio="true" />

                <Label fx:id="lblFecha"
                       text="Miércoles, 9 de septiembre de 2026"
                       styleClass="fecha"/>

                <Label fx:id="lblHora"
                       text="19:13"
                       styleClass="hora"/>
            </VBox>

        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="contenido-principal">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <HBox spacing="14">

                <Button onAction="#mostrarTurnos"
                        styleClass="card-navegacion"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">

                            <VBox spacing="4">
                                <Label text="Nuevo Turno" styleClass="titulo-card"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="◫" styleClass="icono-card"/>
                                    <Label text="Asignar un turno rápidamente" styleClass="descripcion-card"/>
                                </HBox>
                            </VBox>

                            <StackPane HBox.hgrow="ALWAYS"/>

                            <Label text="›" styleClass="flecha-card"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button onAction="#mostrarDoctores"
                        styleClass="card-navegacion"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">

                            <VBox spacing="4">
                                <Label text="Doctores" styleClass="titulo-card"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="♧" styleClass="icono-card"/>
                                    <Label text="Gestión de médicos y especialidades" styleClass="descripcion-card"/>
                                </HBox>
                            </VBox>

                            <StackPane HBox.hgrow="ALWAYS"/>

                            <Label text="›" styleClass="flecha-card"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button onAction="#mostrarPacientes"
                        styleClass="card-navegacion"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">

                            <VBox spacing="4">
                                <Label text="Pacientes" styleClass="titulo-card"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="♟" styleClass="icono-card"/>
                                    <Label text="Alta, baja y consulta de pacientes" styleClass="descripcion-card"/>
                                </HBox>
                            </VBox>

                            <StackPane HBox.hgrow="ALWAYS"/>

                            <Label text="›" styleClass="flecha-card"/>
                        </HBox>
                    </graphic>
                </Button>

            </HBox>

            <StackPane fx:id="contenedorPrincipal"
                       VBox.vgrow="ALWAYS"
                       styleClass="contenedor-vistas">

                <VBox alignment="CENTER" spacing="8">
                    <Label text="Agenda de hoy" styleClass="titulo-agenda"/>
                    <Label text="Seleccioná una opción para comenzar" styleClass="subtitulo-agenda"/>
                </VBox>

            </StackPane>

        </VBox>
    </center>

</BorderPane>