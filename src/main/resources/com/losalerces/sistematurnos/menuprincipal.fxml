<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.losalerces.sistematurnos.Controladores.controladorMenuprincipal"
            minWidth="800"
            minHeight="600"
            prefWidth="1100"
            prefHeight="720"
            styleClass="root-principal"
            stylesheets="@style.css">

    <!-- ================================================= -->
    <!-- CABECERA -->
    <!-- ================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="18"
              minHeight="90"
              maxWidth="Infinity"
              styleClass="header">

            <padding>
                <Insets top="8"
                        right="24"
                        bottom="8"
                        left="24"/>
            </padding>

            <!-- LOGO -->

            <ImageView fx:id="imageView"
                       fitWidth="170"
                       fitHeight="80"
                       preserveRatio="true"
                       smooth="true"
                       cache="false"/>

            <StackPane HBox.hgrow="ALWAYS"/>

            <!-- FECHA / HORA -->

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label fx:id="lblFecha"
                       styleClass="fecha"
                       text="Miércoles, 9 de septiembre de 2026"/>

                <Label fx:id="lblHora"
                       styleClass="hora"
                       text="19:50"/>

            </VBox>

        </HBox>

    </top>


    <!-- ================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ================================================= -->

    <center>

        <VBox spacing="16"
              fillWidth="true"
              minWidth="0"
              minHeight="0"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="contenido-principal">

            <padding>
                <Insets top="16"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>


            <!-- ================================================= -->
            <!-- TARJETAS -->
            <!-- ================================================= -->

            <HBox spacing="14"
                  maxWidth="Infinity"
                  fillHeight="true">


                <!-- NUEVO TURNO -->

                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      minWidth="0"
                      maxWidth="Infinity"
                      onMouseClicked="#mostrarTurnos"
                      styleClass="card-navegacion"
                      HBox.hgrow="ALWAYS">

                    <Label styleClass="icono-card"
                           text="▣"/>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <Label styleClass="titulo-card"
                               text="Nuevo Turno"/>

                        <Label styleClass="descripcion-card"
                               text="Asignar un turno rápidamente"
                               wrapText="true"
                               maxWidth="Infinity"/>

                    </VBox>

                    <Label styleClass="flecha-card"
                           text="›"/>

                </HBox>


                <!-- DOCTORES -->

                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      minWidth="0"
                      maxWidth="Infinity"
                      onMouseClicked="#mostrarDoctores"
                      styleClass="card-navegacion"
                      HBox.hgrow="ALWAYS">

                    <Label styleClass="icono-card"
                           text="⚕"/>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <Label styleClass="titulo-card"
                               text="Doctores"/>

                        <Label styleClass="descripcion-card"
                               text="Médicos, especialidades y obras sociales"
                               wrapText="true"
                               maxWidth="Infinity"/>

                    </VBox>

                    <Label styleClass="flecha-card"
                           text="›"/>

                </HBox>


                <!-- PACIENTES -->

                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      minWidth="0"
                      maxWidth="Infinity"
                      onMouseClicked="#mostrarPacientes"
                      styleClass="card-navegacion"
                      HBox.hgrow="ALWAYS">

                    <Label styleClass="icono-card"
                           text="👤"/>

                    <VBox spacing="3"
                          minWidth="0"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <Label styleClass="titulo-card"
                               text="Pacientes"/>

                        <Label styleClass="descripcion-card"
                               text="Alta, baja y consulta de pacientes"
                               wrapText="true"
                               maxWidth="Infinity"/>

                    </VBox>

                    <Label styleClass="flecha-card"
                           text="›"/>

                </HBox>

            </HBox>


            <!-- ================================================= -->
            <!-- CONTENEDOR DE VISTAS -->
            <!-- ================================================= -->

            <StackPane fx:id="contenedorPrincipal"
                       alignment="TOP_LEFT"
                       minWidth="0"
                       minHeight="0"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       VBox.vgrow="ALWAYS">


                <!-- ================================================= -->
                <!-- AGENDA PRINCIPAL -->
                <!-- ================================================= -->

                <VBox fx:id="panelAgenda"
                      spacing="12"
                      minWidth="0"
                      minHeight="0"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="contenedor-vistas"
                      VBox.vgrow="ALWAYS">


                    <!-- CABECERA AGENDA -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="10"
                          maxWidth="Infinity">

                        <VBox spacing="1"
                              minWidth="0"
                              HBox.hgrow="ALWAYS">

                            <Label styleClass="titulo-agenda"
                                   text="Agenda de hoy"/>

                            <Label fx:id="lblFechaAgenda"
                                   styleClass="subtitulo-agenda"
                                   text="Miércoles, 9 de septiembre de 2026"
                                   wrapText="true"/>

                        </VBox>

                        <Label styleClass="actualizacion"
                               text="Actualización automática"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- TABLA -->
                    <!-- ================================================= -->

                    <TableView fx:id="tablaAgenda"
                               minHeight="0"
                               maxWidth="Infinity"
                               maxHeight="Infinity"
                               styleClass="tabla-agenda"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colHora"
                                         minWidth="55"
                                         prefWidth="80"
                                         text="Hora"/>

                            <TableColumn fx:id="colPaciente"
                                         minWidth="100"
                                         prefWidth="180"
                                         text="Paciente"/>

                            <TableColumn fx:id="colDoctor"
                                         minWidth="100"
                                         prefWidth="165"
                                         text="Doctor"/>

                            <TableColumn fx:id="colEspecialidad"
                                         minWidth="110"
                                         prefWidth="175"
                                         text="Especialidad"/>

                            <TableColumn fx:id="colEstado"
                                         minWidth="80"
                                         prefWidth="130"
                                         text="Estado"/>

                            <TableColumn fx:id="colAcciones"
                                         minWidth="80"
                                         prefWidth="100"
                                         text="Acciones"/>

                        </columns>

                    </TableView>

                </VBox>

            </StackPane>

        </VBox>

    </center>

</BorderPane>