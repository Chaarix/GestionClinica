<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.losalerces.sistematurnos.Controladores.controladorTurnos"
      spacing="12"
      minWidth="0"
      minHeight="0"
      maxWidth="Infinity"
      maxHeight="Infinity"
      fillWidth="true"
      styleClass="vista-base">

    <padding>
        <Insets top="8"
                right="8"
                bottom="8"
                left="8"/>
    </padding>


    <!-- ================================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================================= -->

    <HBox alignment="CENTER_LEFT"
          spacing="10"
          minHeight="45"
          maxWidth="Infinity">

        <VBox spacing="2"
              minWidth="0"
              HBox.hgrow="ALWAYS">

            <Label text="Turnos"
                   styleClass="titulo-vista"/>

            <Label text="Asignación y administración de turnos"
                   styleClass="subtitulo-vista"/>

        </VBox>

        <Button text="Actualizar"
                onAction="#actualizarTurnos"
                styleClass="boton-secundario"/>

    </HBox>


    <!-- ================================================= -->
    <!-- PRIMERA FILA -->
    <!-- ================================================= -->

    <HBox spacing="12"
          maxWidth="Infinity"
          styleClass="panel-formulario">

        <!-- FECHA -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Fecha"
                   styleClass="label-campo"/>

            <DatePicker fx:id="dpFecha"
                        maxWidth="Infinity"/>

        </VBox>


        <!-- DOCTOR -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Doctor"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbDoctor"
                      promptText="Seleccionar doctor"
                      maxWidth="Infinity"
                      onAction="#cargarHorarios"/>

        </VBox>


        <!-- HORARIO -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Horario"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbHorario"
                      promptText="Seleccionar horario"
                      maxWidth="Infinity"/>

        </VBox>

    </HBox>


    <!-- ================================================= -->
    <!-- SEGUNDA FILA -->
    <!-- ================================================= -->

    <HBox spacing="12"
          maxWidth="Infinity"
          styleClass="panel-formulario">

        <!-- PACIENTE -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Paciente"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbPaciente"
                      promptText="Seleccionar paciente"
                      maxWidth="Infinity"/>

        </VBox>


        <!-- ESPECIALIDAD -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Especialidad"
                   styleClass="label-campo"/>

            <Label fx:id="lblEspecialidad"
                   text="-"
                   styleClass="dato-destacado"
                   wrapText="true"/>

        </VBox>


        <!-- OBRA SOCIAL -->

        <VBox spacing="5"
              minWidth="0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS">

            <Label text="Obra social"
                   styleClass="label-campo"/>

            <Label fx:id="lblObraSocial"
                   text="-"
                   styleClass="dato-destacado"
                   wrapText="true"/>

        </VBox>

    </HBox>


    <!-- ================================================= -->
    <!-- BOTONES FORMULARIO -->
    <!-- ================================================= -->

    <HBox alignment="CENTER_RIGHT"
          spacing="10"
          maxWidth="Infinity">

        <Button text="Limpiar"
                onAction="#limpiarFormulario"
                styleClass="boton-secundario"/>

        <Button text="Guardar turno"
                onAction="#guardarTurno"
                styleClass="boton-principal"/>

    </HBox>


    <!-- ================================================= -->
    <!-- AGENDA -->
    <!-- ================================================= -->

    <VBox spacing="8"
          minHeight="0"
          maxWidth="Infinity"
          maxHeight="Infinity"
          VBox.vgrow="ALWAYS">

        <!-- ENCABEZADO AGENDA -->

        <HBox alignment="CENTER_LEFT"
              spacing="8"
              maxWidth="Infinity">

            <VBox spacing="2"
                  minWidth="0"
                  HBox.hgrow="ALWAYS">

                <Label text="Agenda del día"
                       styleClass="titulo-seccion"/>

                <Label fx:id="lblFechaAgenda"
                       text="Turnos programados"
                       styleClass="subtitulo-vista"/>

            </VBox>


            <Button text="‹"
                    onAction="#diaAnterior"
                    styleClass="boton-mini"/>

            <Button text="Hoy"
                    onAction="#irHoy"
                    styleClass="boton-mini"/>

            <Button text="›"
                    onAction="#diaSiguiente"
                    styleClass="boton-mini"/>

        </HBox>


        <!-- ================================================= -->
        <!-- TABLA -->
        <!-- ================================================= -->

        <TableView fx:id="tablaTurnos"
                   minHeight="0"
                   maxHeight="Infinity"
                   maxWidth="Infinity"
                   styleClass="tabla-agenda"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colHora"
                             minWidth="60"
                             prefWidth="80"
                             text="Hora"/>

                <TableColumn fx:id="colPaciente"
                             minWidth="100"
                             prefWidth="160"
                             text="Paciente"/>

                <TableColumn fx:id="colDoctor"
                             minWidth="100"
                             prefWidth="150"
                             text="Doctor"/>

                <TableColumn fx:id="colEspecialidad"
                             minWidth="105"
                             prefWidth="150"
                             text="Especialidad"/>

                <TableColumn fx:id="colObraSocial"
                             minWidth="100"
                             prefWidth="135"
                             text="Obra social"/>

                <TableColumn fx:id="colEstado"
                             minWidth="85"
                             prefWidth="120"
                             text="Estado"/>

                <TableColumn fx:id="colAcciones"
                             minWidth="90"
                             prefWidth="110"
                             text="Acciones"/>

            </columns>

        </TableView>

    </VBox>

</VBox>