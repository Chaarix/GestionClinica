<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.losalerces.sistematurnos.Controladores.controladorTurnos"
      spacing="14"
      styleClass="vista-base">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT">

        <VBox spacing="2">
            <Label text="Turnos"
                   styleClass="titulo-vista"/>

            <Label text="Asignación y administración de turnos"
                   styleClass="subtitulo-vista"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizarTurnos"
                styleClass="boton-secundario"/>

    </HBox>

    <!-- FORMULARIO -->
    <HBox spacing="12"
          styleClass="panel-formulario">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Fecha"
                   styleClass="label-campo"/>

            <DatePicker fx:id="dpFecha"
                        maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Doctor"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbDoctor"
                      promptText="Seleccionar doctor"
                      maxWidth="Infinity"
                      onAction="#cargarHorarios"/>
        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Horario"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbHorario"
                      promptText="Seleccionar horario"
                      maxWidth="Infinity"/>
        </VBox>

    </HBox>

    <!-- SEGUNDA FILA -->
    <HBox spacing="12"
          styleClass="panel-formulario">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Paciente"
                   styleClass="label-campo"/>

            <ComboBox fx:id="cmbPaciente"
                      promptText="Seleccionar paciente"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Especialidad"
                   styleClass="label-campo"/>

            <Label fx:id="lblEspecialidad"
                   text="-"
                   styleClass="dato-destacado"/>
        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Obra social"
                   styleClass="label-campo"/>

            <Label fx:id="lblObraSocial"
                   text="-"
                   styleClass="dato-destacado"/>
        </VBox>

    </HBox>

    <!-- BOTONES -->
    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Limpiar"
                onAction="#limpiarFormulario"
                styleClass="boton-secundario"/>

        <Button text="Guardar turno"
                onAction="#guardarTurno"
                styleClass="boton-principal"/>

    </HBox>

    <!-- AGENDA -->
    <VBox spacing="8"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT">

            <VBox spacing="2">

                <Label text="Agenda del día"
                       styleClass="titulo-seccion"/>

                <Label fx:id="lblFechaAgenda"
                       text="Turnos programados"
                       styleClass="subtitulo-vista"/>

            </VBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="‹"
                    onAction="#diaAnterior"
                    styleClass="boton-mini"/>

            <Button text="Hoy"
                    onAction="#irHoy"
                    styleClass="boton-mini"/>

            <Button text="›"
                    onAction="#diaSiguiente"
                    styleClass="boton-mini"/>

        </HBox>

        <TableView fx:id="tablaTurnos"
                   VBox.vgrow="ALWAYS"
                   styleClass="tabla-agenda">

            <columns>

                <TableColumn fx:id="colHora"
                             text="Hora"/>

                <TableColumn fx:id="colPaciente"
                             text="Paciente"/>

                <TableColumn fx:id="colDoctor"
                             text="Doctor"/>

                <TableColumn fx:id="colEspecialidad"
                             text="Especialidad"/>

                <TableColumn fx:id="colObraSocial"
                             text="Obra social"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </VBox>

</VBox>