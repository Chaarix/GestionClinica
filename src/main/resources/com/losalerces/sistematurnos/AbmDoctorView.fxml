<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<SplitPane dividerPositions="0.45" prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.losalerces.sistematurnos.Controladores.DoctorController">
    <items>
        <!-- SECCIÓN IZQUIERDA: BUSCADOR Y TABLA -->
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-weight: bold;" text="Buscar:" />
                <TextField fx:id="txtBuscar" promptText="Filtrar por apellido o DNI..." HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="tblDoctores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colApellido" prefWidth="130.0" text="Apellido" />
                    <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                    <TableColumn fx:id="colEspecialidad" prefWidth="140.0" text="Especialidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnEliminar" onAction="#handleEliminar" style="-fx-base: #f44336; -fx-text-fill: white;" text="Dar de Baja" />
                <Label style="-fx-font-style: italic; -fx-text-fill: gray;" text="* Seleccione un profesional para editar sus datos." />
            </HBox>
        </VBox>

        <!-- SECCIÓN DERECHA: FORMULARIO COMPLETO -->
        <VBox spacing="15.0" style="-fx-background-color: #fcfcfc;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <!-- Título principal -->
            <Label fx:id="lblTituloForm" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Registrar Nuevo Doctor" />

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <GridPane hgap="15" vgap="20">
                    <columnConstraints>
                        <!-- Se le da un ancho fijo adecuado a las etiquetas de texto -->
                        <ColumnConstraints minWidth="120.0" prefWidth="130.0" />
                        <!-- Se obliga a la segunda columna (los cuadros) a estirarse por completo -->
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                    </columnConstraints>

                    <!-- Campo Nombre -->
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Nombre *:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtNombre" maxWidth="Infinity" promptText="Nombres" style="-fx-font-size: 16px; -fx-pref-height: 38px;" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS" />

                    <!-- Campo Apellido -->
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Apellido *:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtApellido" maxWidth="Infinity" promptText="Apellidos" style="-fx-font-size: 16px; -fx-pref-height: 38px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- Campo Especialidad -->
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Especialidad *:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <ComboBox fx:id="cmbEspecialidad" maxWidth="Infinity" promptText="Seleccione una..." style="-fx-font-size: 16px; -fx-pref-height: 38px;" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.hgrow="ALWAYS" />

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </ScrollPane>

            <Separator />

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#handleLimpiarFormulario" style="-fx-font-size: 14px; -fx-pref-height: 38px; -fx-padding: 0 15 0 15;" text="Limpiar / Nuevo" />
                <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-base: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-height: 38px; -fx-padding: 0 20 0 20;" text="Guardar Doctor" />
            </HBox>
        </VBox>
    </items>
</SplitPane>
