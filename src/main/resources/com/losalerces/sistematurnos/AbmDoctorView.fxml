<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.55" prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.losalerces.sistematurnos.Controladores.DoctorController">
    <items>
        <!-- SECCIÓN IZQUIERDA: BUSCADOR Y TABLA -->
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-weight: bold;" text="Buscar:" />
                <TextField fx:id="txtBuscar" promptText="Filtrar por apellido o DNI..." HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="tblDoctores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                    <TableColumn fx:id="colApellido" prefWidth="130.0" text="Apellido" />
                    <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                    <TableColumn fx:id="colEspecialidad" prefWidth="140.0" text="Especialidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnEliminar" onAction="#handleEliminar" style="-fx-base: #f44336; -fx-text-fill: white;" text="Dar de Baja" />
                <Label style="-fx-font-style: italic; -fx-text-fill: gray;" text="* Seleccione un profesional para editar sus datos." />
            </HBox>
        </VBox>

        <!-- SECCIÓN DERECHA: FORMULARIO COMPLETO -->
        <VBox spacing="15.0" style="-fx-background-color: #fcfcfc;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <Label fx:id="lblTituloForm" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Registrar Nuevo Doctor" />

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
                <GridPane hgap="15" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="95" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <!-- Campo DNI -->
                    <Label text="DNI *:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtDni" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="204.0" promptText="Número de documento" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <!-- Campo Nombre -->
                    <Label text="Nombre *:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtNombre" maxWidth="1.7976931348623157E308" promptText="Nombres" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <!-- Campo Apellido -->
                    <Label text="Apellido *:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtApellido" maxWidth="1.7976931348623157E308" promptText="Apellidos" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <!-- Campo Teléfono -->
                    <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="txtTelefono" maxWidth="1.7976931348623157E308" promptText="Ej: +54 2945..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <!-- Campo Correo -->
                    <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="txtCorreo" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="233.0" promptText="ejemplo@correo.com" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <!-- Campo Especialidad -->
                    <Label text="Especialidad *:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <ComboBox fx:id="cmbEspecialidad" maxWidth="1.7976931348623157E308" prefWidth="Infinity" promptText="Seleccione una..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </ScrollPane>

            <Separator />

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#handleLimpiarFormulario" text="Limpiar / Nuevo" />
                <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-base: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Doctor" />
            </HBox>
        </VBox>
    </items>
</SplitPane>
